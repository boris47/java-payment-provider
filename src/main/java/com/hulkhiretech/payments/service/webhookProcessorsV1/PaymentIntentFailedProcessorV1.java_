package com.hulkhiretech.payments.service.webhookProcessorsV1;

import org.springframework.stereotype.Service;

import com.stripe.model.PaymentIntent;
import com.stripe.model.StripeObject;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;

// Occurs when a PaymentIntent has failed the attempt to create a payment method or a payment.
@Slf4j
@Service("v1.payment_intent.payment_failed")
@RequiredArgsConstructor
public class PaymentIntentFailedProcessorV1 extends BaseWebhookProcessor
{
	@Override
	public <T extends StripeObject> void process(T eventObj)
	{
		PaymentIntent paymentIntent = (PaymentIntent) eventObj;
		
		String id = paymentIntent.getId();
		Long amount = paymentIntent.getAmount();
		String currency = paymentIntent.getCurrency();
		String status = paymentIntent.getStatus();
		String message = paymentIntent.getLastPaymentError() != null
			? paymentIntent.getLastPaymentError().getMessage() : "N/A";

		log.info("Payment failed: id='{}', amount='{}', currency='{}', status='{}', failure_message='{}'",
			id,
			String.format("%05d", amount),
			currency,
			status,
			message
		);
	}
}
